# ==============================================================================
# PLIX OPS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL (Used in email buttons and action links)
NEXT_PUBLIC_APP_URL=http://localhost:4500

# ------------------------------------------------------------------------------
# SUPABASE SHARED STATE + REALTIME
# Run the SQL files in supabase/migrations, then provide the project values below.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side. Never prefix it with NEXT_PUBLIC_.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_ID=plix-ops-main

# ------------------------------------------------------------------------------
# 1. GMAIL API CONFIGURATION (RECOMMENDED & 100% FREE)
# Sends automated workflow emails with the embedded PlixOps logo PNG
# ------------------------------------------------------------------------------
# Steps to obtain:
# 1. In Google Cloud Console (https://console.cloud.google.com), enable "Gmail API".
# 2. In APIs & Services -> Credentials, create an OAuth 2.0 Client ID (Web Application)
#    with redirect URI: https://developers.google.com/oauthplayground
# 3. In OAuth Playground, authorize https://www.googleapis.com/auth/gmail.send and copy the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=

# Optional: During testing, route all team workflow emails to your personal inbox
DEV_NOTIFICATION_EMAIL=addyghag@gmail.com

# ------------------------------------------------------------------------------
# 2. MOBILE PHONE & SMS GATEWAYS (OPTIONAL)
# Note: Free mobile push alerts via ntfy.sh (https://ntfy.sh/plix-{phone}) work
# out-of-the-box with ZERO configuration.
# ------------------------------------------------------------------------------

# OPTION A: Fast2SMS (India Gateway)
FAST2SMS_API_KEY=

# OPTION B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION C: Custom Webhook
SMS_GATEWAY_WEBHOOK_URL=
